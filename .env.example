# Mallow — environment variables.
#
# 🔴 Names and placeholders only. Never commit real values.
# Every name below is one the deployed service actually reads.

# ---- Google Cloud / Gemini -------------------------------------------------
GOOGLE_CLOUD_PROJECT=your-project-id
GEMINI_LOCATION=global
# Optional. Defaults to the model named in spike/voice/gemini.py.
# MALLOW_MODEL=gemini-3.7-flash

# ---- Storage ---------------------------------------------------------------
# "1" uses Cloud Firestore, which is the production store. Unset uses a local
# file journal, which is for development only.
MALLOW_FIRESTORE=1
MALLOW_DATA_DIR=./data/live

# ---- Session ---------------------------------------------------------------
# 🔴 Signs the navigation cookie. Generate a strong random value; rotating it
# signs everybody out. It is a server secret and never reaches the browser.
MALLOW_SESSION_SECRET=generate-a-strong-random-value

# ---- Firebase (web config; public by design) -------------------------------
# These reach the browser and are not server credentials. Security comes from
# Firebase Auth, server-side token verification and deny-all Firestore rules —
# not from hiding this block.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_API_KEY=your-firebase-web-api-key
FIREBASE_AUTH_DOMAIN=your-firebase-project-id.firebaseapp.com
REQUIRE_FIREBASE_AUTH=1

# ---- The scheduled reflection endpoint -------------------------------------
# Cloud Scheduler presents an OIDC token. Both are required: a service account
# without an audience is a half-checked token, because verification would skip
# the audience claim and accept a token minted for a different service.
TASKS_SERVICE_ACCOUNT=mallow-tasks@your-project-id.iam.gserviceaccount.com
TASKS_AUDIENCE=https://your-cloud-run-url

# ---- Development only ------------------------------------------------------
# MALLOW_FAKE_MODEL=1   deterministic stand-in for the model; never in production
# MALLOW_EPHEMERAL=1    nothing touches disk; used by the test suite
