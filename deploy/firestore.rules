rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Mallow's browser never talks to Firestore. All application reads and
    // writes go through Cloud Run and the server SDK, which uses IAM and
    // bypasses these client rules.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
